<o:EntityAttribute Id="o43">
<a:ObjectID>3C027C64-B69E-5694-82C8-AFA4566F5ACF</a:ObjectID>
<a:Name>结论</a:Name>
<a:Code>verdict</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>该键上次的结论
重投时直接返回这个结论，不再执行
@enum SyncVerdict default=Success
  0=Success    成功
  1=Skip       跳过（条件不满足，不是错误）
  2=Fatal      业务失败（不可重试）
  3=Retriable  暂时失败（可重试）</a:Comment>
<a:DataType>SI</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
