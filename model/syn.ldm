</o:EntityAttribute>
<o:EntityAttribute Id="o59">
<a:ObjectID>62209B9D-D662-57BF-B2B3-FA6A8D7241F3</a:ObjectID>
<a:Name>单批行数</a:Name>
<a:Code>batch_size</a:Code>
