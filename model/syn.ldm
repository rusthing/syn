<c:Attributes>
<o:EntityAttribute Id="o11">
<a:ObjectID>56F19B67-94FD-57DD-A185-1149AE62A760</a:ObjectID>
<a:Name>ID</a:Name>
<a:Code>id</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>ID
由 idworker 生成，全局唯一</a:Comment>
<a:DataType>LI</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o12">
<a:ObjectID>CCAB6048-3544-5DA4-BD74-EBC9F5B53AD3</a:ObjectID>
<a:Name>任务编码</a:Name>
<a:Code>code</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>任务编码
人写可读的稳定标识，配置、日志、排障都用它指代一条任务；接口按它查询
@len 1..=64</a:Comment>
<a:DataType>VA64</a:DataType>
<a:Length>64</a:Length>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o13">
<a:ObjectID>137EFD32-A529-5137-A358-DED60E318049</a:ObjectID>
<a:Name>名称</a:Name>
<a:Code>name</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>名称
给人看的名字，列表页展示
@len 1..=100</a:Comment>
<a:DataType>VA100</a:DataType>
<a:Length>100</a:Length>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o14">
<a:ObjectID>BF107FB3-88A2-5E23-BC5E-717CF0404CF1</a:ObjectID>
<a:Name>来源topic</a:Name>
<a:Code>topic</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>来源 topic
push 入口是 Kafka 的 topic；poll 入口是虚拟 topic（source:{数据源编码}）
@len 1..=255</a:Comment>
<a:DataType>VA255</a:DataType>
<a:Length>255</a:Length>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o15">
<a:ObjectID>5E7C3604-74F5-564E-8408-FCFF2E233B5A</a:ObjectID>
<a:Name>匹配优先级</a:Name>
<a:Code>priority</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>匹配优先级
升序匹配，同 topic 下按优先级逐个试；数字小的先试
@range 0..=9999</a:Comment>
<a:DefaultValue>100</a:DefaultValue>
<a:DataType>I</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o16">
<a:ObjectID>0F289B00-8774-5D7C-BC4C-495AA113898F</a:ObjectID>
<a:Name>是否启用</a:Name>
<a:Code>enabled</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>是否启用
停用只影响匹配，规则原样保留</a:Comment>
<a:DefaultValue>true</a:DefaultValue>
<a:DataType>BL</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o17">
<a:ObjectID>DBA8532B-7A99-504B-AD1D-8AF6624820C9</a:ObjectID>
<a:Name>命中后停止匹配</a:Name>
<a:Code>exclusive</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>命中后是否停止匹配后续任务
false 表示这条记录还要继续喂给后面的任务（一分多）</a:Comment>
<a:DefaultValue>true</a:DefaultValue>
<a:DataType>BL</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o18">
<a:ObjectID>9725094D-B8DC-513A-8A1B-93638D3E7484</a:ObjectID>
<a:Name>五段规则</a:Name>
<a:Code>spec</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>五段规则（match / mapping / actions / guards / outcomes）
嵌套结构，整体被执行器消费，没有任何一列参与检索，所以按 JSONB 存
topic / priority / enabled / exclusive 以本表的列为准，spec 里的同名字段只是导入来源</a:Comment>
<a:DataType>JSONB</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o19">
<a:ObjectID>FC39AA9E-0E29-56FA-9904-5D841B15138A</a:ObjectID>
<a:Name>配置版本</a:Name>
<a:Code>version</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>配置版本号
每次发布 +1，执行器按版本判断是否需要重新拉快照
@range 1..=2147483647</a:Comment>
<a:DefaultValue>1</a:DefaultValue>
<a:DataType>I</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o20">
<a:ObjectID>E8D4BD2C-3546-5DEC-919C-66A383AEE361</a:ObjectID>
<a:Name>备注</a:Name>
<a:Code>remark</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>备注
@len 0..=500</a:Comment>
<a:DataType>VA500</a:DataType>
<a:Length>500</a:Length>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o21">
<a:ObjectID>90CCC2EC-E79E-5DA4-9E57-BBC5DBBE7A24</a:ObjectID>
<a:Name>创建者ID</a:Name>
<a:Code>creater_id</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>创建者ID
由框架在新增时写入当前操作者；无登录态的系统写入写 0</a:Comment>
<a:DataType>LI</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o22">
<a:ObjectID>B617167C-BE9B-5A02-9034-C68C3757D4A4</a:ObjectID>
<a:Name>创建时间戳</a:Name>
<a:Code>create_ms</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>创建时间戳
由框架在新增时写入当前时间
@unit ms</a:Comment>
<a:DataType>LI</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
