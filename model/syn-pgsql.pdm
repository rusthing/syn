<a:Code>task_id</a:Code>
<a:CreationDate>1794481012</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1794481012</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>任务 ID
幂等按「任务维度」记账，不按记录维度：同一条记录的两个任务各自成功才算整体成功</a:Comment>
<a:History>ORG {8F0CF8FB-130A-56F1-8BE6-BFE70FAB1522}
DAT 1794481012</a:History>
<a:DataType>INT8</a:DataType>
<a:Length>8</a:Length>
<a:Column.Mandatory>1</a:Column.Mandatory>
<a:GlobalObjectID/>
</o:Column>
