{
  "name": "联调-判定语句嵌套",
  "remark": "e2e: switch 分流 + 臂内 if 两层判定（on conflict do nothing 造出 affected=0/1 两种响应；db 只能看 affected）",
  "spec": {
    "topic": "source:it_judge",
    "sort_order": 200,
    "enabled": true,
    "exclusive": true,
    "target": {
      "kind": "db",
      "datasource": "dst",
      "table": "public.demo_person",
      "key": ["id"],
      "on_conflict": "nothing"
    },
    "match": [],
    "mapping": {
      "omit_null": true,
      "rows": [
        { "to": "id", "from": "$.after.id" },
        { "to": "name", "from": "$.after.name" },
        { "to": "updated_at", "from": "$.after.updated_at" }
      ]
    },
    "guards": [],
    "rules": [
      {
        "kind": "switch",
        "on": "$.affected",
        "scope": "body",
        "cases": [
          {
            "values": [0],
            "then": [{ "kind": "outcome", "verdict": "skip", "code": "R_DUPLICATE" }]
          },
          {
            "values": [1],
            "then": [
              {
                "kind": "if",
                "branches": [
                  {
                    "assert": [{ "field": "$.affected", "op": "eq", "value": 1 }],
                    "then": [{ "kind": "outcome", "verdict": "success", "code": "R_WROTE" }]
                  },
                  {
                    "assert": [],
                    "then": [{ "kind": "outcome", "verdict": "fatal", "code": "R_BAD_AFFECTED" }]
                  }
                ]
              }
            ]
          }
        ],
        "default": [{ "kind": "outcome", "verdict": "fatal", "code": "R_UNEXPECTED" }]
      }
    ]
  }
}
