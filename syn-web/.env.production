# `pnpm build` 自动读取本文件（Vite 的 production 模式）。
# 临时换部署位置不用改这里：命令行环境变量优先级更高，例如
#   PUBLIC_BASE=/syn-web-test/ pnpm build

# 页面挂载路径，必须与 nginx 的 location 完全一致（注意末尾斜杠）。
# 它同时决定 index.html 里 /assets/* 的前缀和前端路由的 basename。
PUBLIC_BASE=/syn-web/

# 接口前缀：网关按此前缀把请求转发到 syn-svr（`/syn/*` 是后端真实路径）。
VITE_API_BASE=/syn-svr

# 令牌不写进构建产物：部署时由网关注入，或在页面上临时填（不落盘）。

# 静态服务器配不了 SPA 回退时改成 hash。
VITE_ROUTER=browser

# adm 统一身份：生产必须登录。AUTH_BASE 已含 /adm 前缀，
# 认证内核会拼出 /adm-rs-svr/adm/auth/login 等路径（与 msg / alarm / dtw 同口径）。
VITE_AUTH_MODE=required
VITE_AUTH_BASE=/adm-rs-svr/adm
