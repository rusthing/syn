# 开发期默认走 `/api` 反代（vite.config.ts 里配的，指向 127.0.0.1:9007）。
# 想连真服务：VITE_API_BASE=/api pnpm dev
# 想纯演示数据（不连后端）：VITE_API_BASE= pnpm dev
VITE_API_BASE=/api

# 同步执行器要求的调用令牌，与会话无关；后端 syn-svr.toml 的 [syn] token。
# 只在「试跑」时随请求发出；留空则不发（后端没配 token 时也接受）。
VITE_SYN_TOKEN=

# 路由模式：browser（默认）| hash（静态服务器配不了 try_files 时用）
VITE_ROUTER=browser
